# Frontend Environment Variables
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_NAME=CareSphere
NEXT_PUBLIC_APP_URL=https://care-sphere-kappa.vercel.app

# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_key_here
BETTER_AUTH_URL=https://care-sphere-kappa.vercel.app
MONGODB_URI=mongodb://<username>:<password>@cluster.mongodb.net:27017/caresphere_db?ssl=true&authSource=admin
JWT_SECRET=your_jwt_secret_key_here

# Social OAuth (Google & GitHub)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
